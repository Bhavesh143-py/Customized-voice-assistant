# ── PVG College Voice Assistant — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values before running.
# NEVER commit .env to version control.

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Options: qwen2.5:1.5b (fast), gemma2:2b (better quality), llama3.2:3b
OLLAMA_LLM_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── STT Configuration ─────────────────────────────────────────────────────────
# Options: tiny.en (fastest), small.en (balanced), medium.en (best accuracy)
WHISPER_MODEL_SIZE=small.en

# ── TTS Configuration — Amy Medium Voice ──────────────────────────────────────
# IMPORTANT: Models are NOT bundled. Place your .onnx file in ./tts_models/
# Voice: en_US-amy-medium
# Download from: https://github.com/rhasspy/piper/releases
#
# File needed: en_US-amy-medium.onnx  AND  en_US-amy-medium.onnx.json
# Place both in: ./tts_models/
#
# To use a different voice, change the filename below:
PIPER_MODEL_PATH=./tts_models/en_US-amy-medium.onnx

# TTS engine selection:
#   piper → Offline Amy voice (fastest, no internet needed) [RECOMMENDED]
#   gtts  → Google Indian English accent (needs internet, ~1-2s extra latency)
TTS_ENGINE=piper

# ── Authentication ─────────────────────────────────────────────────────────────
# CHANGE THESE before deploying to production!
JWT_SECRET_KEY=change-this-before-deploying-pvg-2024-very-long-secret-key
JWT_EXPIRE_MINUTES=480

# Secret required to register new admin accounts
ADMIN_REGISTRATION_SECRET=pvg-admin-secret-2024

# ── Default Admin Account (created on first startup) ──────────────────────────
# Log in with these at /admin.html — change the password immediately!
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=PvgAdmin@2024!
DEFAULT_ADMIN_EMAIL=admin@pvgcoet.ac.in

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, good for development):
DATABASE_URL=sqlite:///./pvg_college.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://pvg_user:your_password@localhost:5432/pvg_college

# ── Service Ports (change if ports are already in use) ────────────────────────
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# QDRANT_PORT=6333
# OLLAMA_PORT=11434
